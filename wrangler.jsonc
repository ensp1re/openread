{
  "name": "openread",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "containers": [
    { "class_name": "OpenRead", "image": "./Dockerfile", "instance_type": "standard-1", "max_instances": 1 }
  ],
  "durable_objects": { "bindings": [{ "name": "OPENREAD", "class_name": "OpenRead" }] },
  "exports": { "OpenRead": { "type": "durable-object", "storage": "sqlite" } }
}
