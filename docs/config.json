{
  "schemaVersion": 2,
  "checks": [
    {
      "id": "lint",
      "argv": [
        "pnpm",
        "lint"
      ],
      "required": true
    },
    {
      "id": "typecheck",
      "argv": [
        "pnpm",
        "typecheck"
      ],
      "required": true
    },
    {
      "id": "unit",
      "argv": [
        "pnpm",
        "test"
      ],
      "required": true
    },
    {
      "id": "build",
      "argv": [
        "sh",
        "-c",
        "NEXT_DIST_DIR=.next-check pnpm build"
      ],
      "required": true,
      "wrapup": true,
      "timeoutSeconds": 600
    },
    {
      "id": "e2e",
      "argv": [
        "sh",
        "-c",
        "NEXT_DIST_DIR=.next-check pnpm exec playwright test e2e/reader.spec.ts"
      ],
      "timeoutSeconds": 900
    },
    {
      "id": "a11y",
      "argv": [
        "sh",
        "-c",
        "NEXT_DIST_DIR=.next-check pnpm exec playwright test e2e/accessibility.spec.ts"
      ],
      "timeoutSeconds": 900
    },
    {
      "id": "extract-unit",
      "argv": [
        "pnpm",
        "vitest",
        "run",
        "src/lib/extract"
      ]
    },
    {
      "id": "live",
      "argv": [
        "sh",
        "-c",
        "LIVE=1 LIVE_URLS=https://www.paulgraham.com/powerful.html,https://www.paulgraham.com/brandage.html,https://www.paulgraham.com/worked.html,https://en.wikipedia.org/wiki/Typography,https://overreacted.io/a-complete-guide-to-useeffect/,https://www.astralcodexten.com/p/the-psychopolitics-of-trauma,https://blog.cloudflare.com/details-of-the-cloudflare-outage-on-july-2-2019/ pnpm vitest run src/lib/extract/live.test.ts"
      ],
      "timeoutSeconds": 300
    },
    {
      "id": "worker",
      "argv": [
        "sh",
        "-c",
        "NEXT_DIST_DIR=.next-check pnpm build >/dev/null && node scripts/check-parse-worker.mjs"
      ],
      "timeoutSeconds": 300
    },
    {
      "id": "library-unit",
      "argv": [
        "pnpm",
        "vitest",
        "run",
        "src/lib/library"
      ]
    },
    {
      "id": "files-unit",
      "argv": [
        "pnpm",
        "vitest",
        "run",
        "src/lib/files",
        "src/lib/sanitize.test.ts"
      ]
    },
    {
      "id": "recent-e2e",
      "argv": [
        "sh",
        "-c",
        "NEXT_DIST_DIR=.next-check pnpm exec playwright test e2e/recent.spec.ts"
      ],
      "timeoutSeconds": 900
    },
    {
      "id": "files-e2e",
      "argv": [
        "sh",
        "-c",
        "NEXT_DIST_DIR=.next-check pnpm exec playwright test e2e/files.spec.ts"
      ],
      "timeoutSeconds": 900
    },
    {
      "id": "book-e2e",
      "argv": [
        "sh",
        "-c",
        "NEXT_DIST_DIR=.next-check pnpm exec playwright test e2e/book.spec.ts"
      ],
      "timeoutSeconds": 900
    },
    {
      "id": "bundle",
      "argv": [
        "sh",
        "-c",
        "NEXT_DIST_DIR=.next-check PORT=3299 node scripts/check-home-js.mjs"
      ],
      "timeoutSeconds": 600
    }
  ]
}
